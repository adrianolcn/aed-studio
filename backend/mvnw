#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Script para Linux e macOS
# Uso: ./mvnw [argumentos-maven]
# Exemplo: ./mvnw spring-boot:run
# ----------------------------------------------------------------------------
# Se o Maven não estiver instalado localmente, este script baixa
# a versão correta automaticamente para ~/.m2/wrapper/
# ----------------------------------------------------------------------------

if [ -z "$JAVA_HOME" ] ; then
  JAVACMD=`which java`
  if [ -z "$JAVACMD" ] ; then
    echo "ERRO: variável JAVA_HOME não está definida e 'java' não foi encontrado no PATH."
    echo "Instale o Java 17+ e tente novamente."
    exit 1
  fi
else
  JAVACMD="$JAVA_HOME/bin/java"
  if [ ! -x "$JAVACMD" ] ; then
    echo "ERRO: JAVA_HOME está definida para '$JAVA_HOME', mas $JAVACMD não foi encontrado."
    exit 1
  fi
fi

MAVEN_PROJECTBASEDIR="${BASH_SOURCE:-$0}"
MAVEN_PROJECTBASEDIR="$(dirname "$MAVEN_PROJECTBASEDIR")"
MAVEN_PROJECTBASEDIR="$(cd "$MAVEN_PROJECTBASEDIR" && pwd)"

WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Baixa o wrapper jar se ainda não existir
if [ ! -f "$WRAPPER_JAR" ]; then
  WRAPPER_URL=$(grep 'wrapperUrl' "$WRAPPER_PROPERTIES" | cut -d'=' -f2)
  echo "Baixando Maven Wrapper de: $WRAPPER_URL"
  if command -v wget > /dev/null; then
    wget -q -O "$WRAPPER_JAR" "$WRAPPER_URL" || rm -f "$WRAPPER_JAR"
  elif command -v curl > /dev/null; then
    curl -sL -o "$WRAPPER_JAR" "$WRAPPER_URL" || rm -f "$WRAPPER_JAR"
  else
    echo "ERRO: nem 'wget' nem 'curl' estão disponíveis. Instale um deles."
    exit 1
  fi
fi

exec "$JAVACMD" \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
