# ═══════════════════════════════════════════════════════
#  AED·Studio — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores.
#
#  NUNCA comite o .env no git — adicione-o ao .gitignore.
# ═══════════════════════════════════════════════════════

# ── Banco de dados (PostgreSQL) ──────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/aedstudio
DATABASE_USER=aedstudio
DATABASE_PASSWORD=troque_esta_senha

# ── JWT ──────────────────────────────────────────────
# Gere uma chave segura com: openssl rand -base64 64
JWT_SECRET=TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA_DE_AO_MENOS_256_BITS

# Duração do access token em milissegundos
# 86400000 = 24 horas | 3600000 = 1 hora | 900000 = 15 minutos
JWT_EXPIRATION_MS=86400000

# Duração do refresh token em milissegundos
# 604800000 = 7 dias
JWT_REFRESH_MS=604800000

# ── Servidor ─────────────────────────────────────────
PORT=8080

# ── CORS — origens permitidas ─────────────────────────
# Separe múltiplas origens com vírgula, sem espaços
# Em desenvolvimento: inclua sua porta local (ex: 5500 para Live Server)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Perfil Spring ─────────────────────────────────────
# dev = logs detalhados | prod = performance
SPRING_PROFILES_ACTIVE=dev
